# ==============================================================================
# FASHION WORLD PRO - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' and populate with your own development/production values.
# IMPORTANT: Never commit your actual '.env' file or secret credentials to version control.

# ------------------------------------------------------------------------------
# Core Flask Application Settings
# ------------------------------------------------------------------------------
SECRET_KEY=your-super-secret-random-hex-key-here
FLASK_ENV=development
FLASK_DEBUG=1

# ------------------------------------------------------------------------------
# Database Connection URL
# ------------------------------------------------------------------------------
# Local Development (SQLite default):
DATABASE_URL=sqlite:///fashion_world.db

# Production (PostgreSQL on Render/Supabase/AWS RDS):
# DATABASE_URL=postgresql://user:password@host:port/database

# ------------------------------------------------------------------------------
# Google Cloud OAuth 2.0 Credentials (Server-Side Flow)
# ------------------------------------------------------------------------------
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth Client ID (Web Application)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Set to 1 only for local development over HTTP; set to 0 or omit in production (HTTPS)
OAUTHLIB_INSECURE_TRANSPORT=1

# ------------------------------------------------------------------------------
# Brevo (Sendinblue) Transactional Email API (HTTPS REST - Port 443)
# ------------------------------------------------------------------------------
# Recommended for cloud hosting (e.g., Render Free tier) where outbound SMTP ports
# (25, 465, 587) are blocked. When BREVO_API_KEY is configured, transactional emails
# (such as login OTP codes) are dispatched over HTTPS port 443 instead of SMTP.
# Obtain from: https://app.brevo.com/settings/keys/api
# BREVO_API_KEY=xkeysib-your-brevo-api-key-here

# ------------------------------------------------------------------------------
# Email Service & Transactional Notifications (Gmail SMTP / Flask-Mail)
# ------------------------------------------------------------------------------
# Fallback when BREVO_API_KEY is omitted (e.g. local development or paid instances)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-character-gmail-app-password
MAIL_DEFAULT_SENDER=Fashion World Pro <your-email@gmail.com>

# ------------------------------------------------------------------------------
# Razorpay Payment Gateway (Test or Live Credentials)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_yourKeyIdHere
RAZORPAY_KEY_SECRET=yourRazorpaySecretHere

# ------------------------------------------------------------------------------
# Stripe Payment Gateway (Optional)
# ------------------------------------------------------------------------------
STRIPE_PUBLISHABLE_KEY=pk_test_yourStripePublishableKey
STRIPE_SECRET_KEY=sk_test_yourStripeSecretKey

# ------------------------------------------------------------------------------
# AI Virtual Try-On Engine (IDM-VTON)
# ------------------------------------------------------------------------------
# Optional Hugging Face User Access Token (bypasses anonymous queue limits on yisol/IDM-VTON)
HF_TOKEN=hf_yourHuggingFaceTokenHere

# Legacy Replicate Token (Optional fallback)
REPLICATE_API_TOKEN=r8_yourReplicateTokenHere
